{
  "version": 1,
  "base": "s1-dimensions",
  "nodes": {
    "client": {
      "shape": "crowd",
      "tone": "blue",
      "label": {
        "vi": "Người dùng",
        "en": "Users"
      },
      "inspector": {
        "what": {
          "vi": "Lưu lượng người dùng biến thiên theo giờ trong ngày (Diurnal) hoặc tăng đột ngột lúc Flash Sale.",
          "en": "User traffic following diurnal cycles or sudden flash-sale spikes."
        },
        "how": {
          "vi": "Gửi hỗn hợp 85% lượt đọc và 15% lượt ghi với yêu cầu p99 ≤ 120 ms.",
          "en": "Sends 85% reads and 15% writes expecting p99 ≤ 120 ms."
        },
        "why": {
          "vi": "Thiết kế theo tải trung bình sẽ quá tải ở đỉnh trưa; thiết kế tĩnh theo đỉnh sẽ lãng phí tiền ban đêm.",
          "en": "Sizing for average fails at peak; static peak sizing wastes nighttime budget."
        }
      }
    },
    "lb": {
      "shape": "block",
      "tone": "purple",
      "icon": "layers",
      "label": {
        "vi": "Load Balancer",
        "en": "Load Balancer"
      },
      "inspector": {
        "what": {
          "vi": "Cặp Load Balancer chia tải Least Connections sang tầng ứng dụng.",
          "en": "Redundant Load Balancer pair using Least Connections routing."
        },
        "how": {
          "vi": "Tự động điều tiết lưu lượng sang các instance mới ngay khi chúng vượt qua Health Check.",
          "en": "Dynamically distributes traffic to newly warmed instances once healthy."
        },
        "why": {
          "vi": "Là điều kiện tiên quyết để tầng tính toán có thể mở rộng ngang (Scale-out).",
          "en": "Prerequisite enabling horizontal scale-out of stateless compute."
        }
      }
    },
    "app": {
      "shape": "block",
      "tone": "green",
      "icon": "cpu",
      "label": {
        "vi": "App Tier",
        "en": "App Tier"
      },
      "inspector": {
        "what": {
          "vi": "Tầng ứng dụng phi trạng thái (mỗi máy cỡ chuẩn xử lý 900 req/s, 0,12 USD/giờ).",
          "en": "Stateless application tier (900 req/s per base instance at $0.12/h)."
        },
        "how": {
          "vi": "Hỗ trợ cả Scale-up (sizeFactor tối đa 4, chi phí luỹ thừa 1,2) và Scale-out (thêm tới 10 instance song song).",
          "en": "Supports both Scale-up (max sizeFactor = 4, superlinear cost) and Scale-out (up to 10 instances)."
        },
        "why": {
          "vi": "Phần tính toán không giữ trạng thái nên mở rộng ngang vừa vượt được trần phần cứng vừa xoá được SPOF.",
          "en": "Stateless compute scales horizontally past single-box hardware limits while eliminating SPOF."
        }
      }
    },
    "app_auto": {
      "shape": "block",
      "tone": "green",
      "icon": "sparkles",
      "label": {
        "vi": "Instance mới",
        "en": "New Instances"
      },
      "inspector": {
        "what": {
          "vi": "Nhóm 3 instance mới do bộ Autoscaler tự động cấp phát khi phát hiện tải tăng vọt.",
          "en": "Three auto-scaled instances launched dynamically upon traffic spike detection."
        },
        "how": {
          "vi": "Cần khoảng thời gian khởi động container (5 s) và làm nóng trình biên dịch JIT / pool kết nối (20 s) mới đạt 100% năng lực.",
          "en": "Requires boot time (5 s) plus JIT and connection pool warm-up (20 s) to reach full capacity."
        },
        "why": {
          "vi": "Giải thích vì sao Autoscaling phản ứng tốt với chu kỳ ngày đêm nhưng bị hụt hơi trước đợt Flash Sale dựng đứng.",
          "en": "Explains why reactive autoscaling handles gradual diurnal waves but lags behind instant flash sales."
        }
      }
    },
    "cache": {
      "shape": "block",
      "tone": "yellow",
      "icon": "zap",
      "label": {
        "vi": "Redis Cache",
        "en": "Redis Cache"
      },
      "inspector": {
        "what": {
          "vi": "Bộ nhớ đệm Read-through đứng trước Primary DB (tập dữ liệu nóng 80.000 key).",
          "en": "Read-through cache shielding Primary DB (80,000-key working set)."
        },
        "how": {
          "vi": "Ở mức 20.000 key chỉ chặn được ~42,5% lượt đọc; nâng lên 80.000 key giúp nâng Hit Ratio lên 85%.",
          "en": "Covers ~42.5% of reads at 20k keys; raising to 80k keys lifts Hit Ratio to 85%."
        },
        "why": {
          "vi": "Giảm trực tiếp tỷ lệ công việc phải xếp hàng tuần tự tại Primary DB theo Định luật Amdahl.",
          "en": "Directly shrinks the serial fraction hitting Primary DB under Amdahl's Law."
        }
      }
    },
    "db": {
      "shape": "db",
      "tone": "orange",
      "label": {
        "vi": "Primary DB",
        "en": "Primary DB"
      },
      "inspector": {
        "what": {
          "vi": "Cơ sở dữ liệu quan hệ xử lý toàn bộ lượt ghi và các lượt đọc Cache Miss.",
          "en": "Primary relational database handling all writes and cache misses."
        },
        "how": {
          "vi": "Giữ trạng thái nhất quán nên thường mở rộng dọc (Scale-up sizeFactor) kết hợp giảm tải bằng Cache/Replica.",
          "en": "Stateful serialization point typically scaled vertically alongside caching and read replicas."
        },
        "why": {
          "vi": "Đóng vai trò thành phần tuần tự (1 − p) chặn trên tốc độ mở rộng của toàn hệ thống nếu không được tối ưu.",
          "en": "Acts as the serial fraction (1 − p) capping overall system speedup when saturated."
        }
      }
    }
  },
  "links": {
    "client-lb": {
      "inspector": {
        "what": {
          "vi": "Chiều Network: kết nối từ người dùng qua Internet tới Load Balancer.",
          "en": "Network dimension: Internet hop from users to Load Balancer."
        },
        "how": {
          "vi": "Bị chi phối bởi khoảng cách địa lý (RTT) và băng thông truyền tải.",
          "en": "Governed by geographic RTT and payload bandwidth."
        },
        "why": {
          "vi": "Khi nghẽn ở chiều này, cần nén dữ liệu, giảm số vòng gọi hoặc đặt CDN gần người dùng.",
          "en": "Network bottlenecks require payload compression, fewer round trips, or edge CDN."
        }
      }
    },
    "cache-db": {
      "inspector": {
        "what": {
          "vi": "Luồng truy vấn đi xuyên qua Cache xuống Primary DB.",
          "en": " serial database traffic bypassing or missing Cache."
        },
        "how": {
          "vi": "Mang toàn bộ 15% lượt ghi cộng phần lượt đọc Cache Miss.",
          "en": "Carries all 15% writes plus uncached read misses."
        },
        "why": {
          "vi": "Quyết định phần tuần tự không thể giải quyết bằng cách chỉ nhân bản tầng App.",
          "en": "Determines the serial workload unaffected by App tier horizontal scaling."
        }
      }
    }
  },
