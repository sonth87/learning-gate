    "s5-amdahl-law": {
      "mode": "memory-2d",
      "show": {
        "nodes": []
      },
      "memory": {
        "kind": "tape",
        "title": {
          "vi": "Định luật Amdahl: Phần tuần tự (1 − p) chặn đứng hệ số tăng tốc S(N)",
          "en": "Amdahl's Law: Serial Fraction (1 − p) Caps Maximum Speedup S(N)"
        },
        "subtitle": {
          "vi": "S(N) = 1 / ((1 − p) + p / N) — Khi N → ∞, tốc độ tối đa bị khoá cứng ở 1 / (1 − p)",
          "en": "S(N) = 1 / ((1 − p) + p / N) — Even with infinite servers, speedup never exceeds 1 / (1 − p)"
        },
        "cells": [
          "80% Song song (p = 0,80)",
          "Chia cho N = 4 máy → còn 20%",
          "Chia cho N = ∞ → tiến về 0%",
          "20% Tuần tự (1 − p = 0,20)",
          "Trần tối đa = 1 / 0,20 = 5×"
        ],
        "activeIndices": [
          3,
          4
        ],
        "pointers": [
          {
            "index": 1,
            "label": "giảm nhanh khi thêm máy",
            "tone": "green"
          },
          {
            "index": 3,
            "label": "không đổi khi thêm App",
            "tone": "rose"
          }
        ],
        "outputPill": {
          "label": {
            "vi": "Hệ quả kiến trúc",
            "en": "Architectural Takeaway"
          },
          "value": {
            "vi": "Muốn vượt trần 5×, bắt buộc phải thu hẹp phần tuần tự (1 − p) bằng Cache, Index hoặc bất đồng bộ",
            "en": "To break the 5× ceiling, shrink the serial fraction (1 − p) via caching, indexing, or async"
          },
          "tone": "orange"
        }
      }
    },
