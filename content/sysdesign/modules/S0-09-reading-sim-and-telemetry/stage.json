{
  "version": 1,
  "base": "s1-intro",
  "nodes": {
    "client": {
      "shape": "crowd",
      "tone": "blue",
      "label": { "vi": "Người dùng", "en": "Users" },
      "inspector": {
        "what": {
          "vi": "Nhóm người dùng gửi lưu lượng request đầu vào (λ) tới dịch vụ qua Internet.",
          "en": "Concurrent users generating incoming request rate (λ) over the Internet."
        },
        "how": {
          "vi": "Trong kịch bản của bài, λ bắt đầu từ 50 req/s ở t = 0 s và tăng đều 5 req/s mỗi giây lên tới 400 req/s ở t = 70 s; mỗi request đặt ngưỡng chờ tối đa 1.500 ms.",
          "en": "Ramps λ linearly from 50 to 400 req/s over 70s (+5 req/s per second) with a 1,500 ms client timeout."
        },
        "why": {
          "vi": "Giúp quan sát trọn vẹn quá trình một dịch vụ chuyển từ trạng thái rảnh sang bận, bão hoà rồi quá tải trên cùng một đường tăng tải.",
          "en": "Lets you observe the full transition from healthy to busy, saturated, and overloaded in one continuous run."
        },
        "tip": {
          "vi": "Khi kéo núm nhân tải (LoadKnob), toàn bộ đường cong lưu lượng đầu vào sẽ được nhân theo hệ số bạn chọn.",
          "en": "Adjusting the LoadKnob scales the incoming traffic curve proportionally."
        }
      }
    },
    "svc": {
      "shape": "block",
      "tone": "green",
      "icon": "cpu",
      "label": { "vi": "App Service", "en": "App Service" },
      "inspector": {
        "what": {
          "vi": "Dịch vụ ứng dụng xử lý yêu cầu với năng lực tối đa μ = 300 req/s mỗi instance và độ trễ cơ bản 15 ms.",
          "en": "Application service with maximum capacity μ = 300 req/s per instance and 15 ms base latency."
        },
        "how": {
          "vi": "Khi λ < 300 req/s (ρ < 1), dịch vụ xử lý kịp; khi λ > 300 req/s (ρ > 1), phần dư λ − μ xếp vào hàng đợi phía trước làm thời gian chờ tăng nhanh.",
          "en": "Keeps up while λ < 300 req/s; once λ > 300 req/s, excess arrivals accumulate in the queue."
        },
        "why": {
          "vi": "Đóng vai trò thành phần mẫu duy nhất để bạn tập đọc mối liên hệ trực tiếp giữa ρ, hàng đợi, p50/p99 và tỉ lệ lỗi.",
          "en": "Single-component sandbox isolating the exact relationship among ρ, queue length, p50/p99, and errors."
        },
        "tip": {
          "vi": "Tăng núm Số instance từ 1 lên 2 sẽ nhân đôi năng lực lên μ = 600 req/s, đưa ρ ở tải đỉnh 400 req/s về mức 0,67.",
          "en": "Increasing Instances from 1 to 2 raises aggregate μ to 600 req/s, dropping peak ρ to 0.67."
        }
      }
    }
  },
  "links": {
    "client-svc": {
      "inspector": {
        "what": {
          "vi": "Đường kết nối HTTP đồng bộ qua Internet từ Người dùng tới App Service.",
          "en": "Synchronous Internet HTTP link from Users to App Service."
        },
        "how": {
          "vi": "Cộng khoảng 30 ms độ trễ mạng cơ bản; hiển thị các hạt request/response và đống hàng đợi dồn trước cửa vào dịch vụ khi quá tải.",
          "en": "Adds ~30 ms Internet RTT and visualizes moving packets plus queue buildup under overload."
        },
        "why": {
          "vi": "Cho phép nhìn bằng mắt thường khi nào lưu lượng thông suốt và khi nào gói tin bị quá hạn 1.500 ms.",
          "en": "Makes packet flow, queueing, and 1,500 ms timeouts immediately visible."
        }
      }
    }
  },
