{
  "version": 1,
  "base": "s1-cluster-setup",
  "nodes": {
    "client": {
      "shape": "crowd",
      "tone": "blue",
      "label": {
        "vi": "Client / Service",
        "en": "Client / Service"
      },
      "inspector": {
        "what": {
          "vi": "Dịch vụ ứng dụng gửi yêu cầu cập nhật cấu hình / trạng thái vào cụm đồng thuận Raft.",
          "en": "Application services proposing state updates to the Raft consensus cluster."
        },
        "how": {
          "vi": "Gửi lệnh ghi tới Leader hiện hành; nếu gửi nhầm vào Follower sẽ được chỉ dẫn chuyển tiếp về Leader.",
          "en": "Sends writes to the active Leader; Followers redirect proposals to the current Leader."
        },
        "why": {
          "vi": "Cần cam kết tuyến tính hoá rằng lệnh đã xác nhận sẽ không bao giờ mất hay bị rẽ nhánh.",
          "en": "Requires linearizable durability across node crashes and network faults."
        }
      }
    },
    "leader": {
      "shape": "block",
      "tone": "orange",
      "icon": "shield",
      "label": {
        "vi": "Node 1 (Leader)",
        "en": "Node 1 (Leader)"
      },
      "inspector": {
        "what": {
          "vi": "Nút Raft đang giữ vai trò Leader ở nhiệm kỳ đầu (Term 1) tại AZ-A.",
          "en": "Raft node acting as Term 1 Leader in AZ-A."
        },
        "how": {
          "vi": "Ghi mục mới vào nhật ký WAL, nhân bản sang Node 2 và Node 3, đợi đủ ≥ 2/3 xác nhận rồi mới nâng commitIndex.",
          "en": "Appends entries locally, replicates to Node 2 & 3, and commits once ≥ 2/3 acknowledge."
        },
        "why": {
          "vi": "Nếu bị cô lập một mình (chỉ còn 1/3 phiếu), bắt buộc từ chối lệnh ghi để ngăn Split-Brain.",
          "en": "Must reject writes if isolated in a 1/3 minority partition to prevent Split-Brain."
        }
      }
    },
    "f1": {
      "shape": "block",
      "tone": "green",
      "icon": "cpu",
      "label": {
        "vi": "Node 2 (Follower)",
        "en": "Node 2 (Follower)"
      },
      "inspector": {
        "what": {
          "vi": "Nút Raft thứ hai đặt tại AZ-B, khởi đầu ở trạng thái Follower.",
          "en": "Second Raft node in AZ-B, initially operating as a Follower."
        },
        "how": {
          "vi": "Nhận nhịp tim AppendEntries từ Leader; khi mất nhịp tim quá ngưỡng ngẫu nhiên sẽ ứng cử lên Term 2.",
          "en": "Resets election timer on heartbeats; campaigns for Term 2 upon timeout."
        },
        "why": {
          "vi": "Cùng với Node 3 tạo thành nhánh đa số 2/3 để bầu Leader mới khi AZ-A bị cô lập.",
          "en": "Forms a 2/3 majority quorum with Node 3 if AZ-A becomes unreachable."
        }
      }
    },
    "f2": {
      "shape": "block",
      "tone": "green",
      "icon": "cpu",
      "label": {
        "vi": "Node 3 (Follower)",
        "en": "Node 3 (Follower)"
      },
      "inspector": {
        "what": {
          "vi": "Nút Raft thứ ba đặt tại AZ-C để hoàn thiện cụm 3 nút số lẻ.",
          "en": "Third Raft node in AZ-C completing the 3-node odd-sized cluster."
        },
        "how": {
          "vi": "Lưu bản sao nhật ký bền vững và chỉ cấp tối đa 1 phiếu bầu trong mỗi Term cho ứng viên có log đủ mới.",
          "en": "Persists replicated log entries and grants at most one vote per Term."
        },
        "why": {
          "vi": "Đóng vai trò lá phiếu quyết định giúp cụm chịu được bất kỳ 1 AZ nào ngừng hoạt động.",
          "en": "Provides the tie-breaking quorum vote across 3 Availability Zones."
        }
      }
    },
    "storage": {
      "shape": "db",
      "tone": "purple",
      "label": {
        "vi": "Kho dữ liệu (Fencing)",
        "en": "Storage (Fencing)"
      },
      "inspector": {
        "what": {
          "vi": "Kho lưu trữ tài nguyên bên ngoài kiểm tra Fencing Token trên từng thao tác ghi.",
          "en": "Downstream resource store enforcing monotonic Fencing Tokens on writes."
        },
        "how": {
          "vi": "Ghi nhớ max_token cao nhất đã thực thi; bác bỏ ngay mọi gói ghi mang token nhỏ hơn.",
          "en": "Tracks highest seen token and rejects stale writes carrying older tokens."
        },
        "why": {
          "vi": "Bảo vệ dữ liệu khỏi tiến trình Leader cũ bị treo GC rồi tỉnh dậy gửi gói tin trễ.",
          "en": "Protects state against delayed packets from a paused Zombie Leader."
        }
      }
    }
  },
  "links": {
    "client-leader": {
      "inspector": {
        "what": {
          "vi": "Đường gửi yêu cầu đồng thuận từ Client vào Node 1.",
