      "style": "heartbeat",
      "inspector": {
        "what": {
          "vi": "Kênh RPC AppendEntries & Heartbeat giữa Node 1 và Node 2 (~2 ms).",
          "en": "AppendEntries & Heartbeat RPC link between Node 1 and Node 2 (~2 ms)."
        },
        "how": {
          "vi": "Truyền mục nhật ký mới kèm nhịp tim duy trì quyền Leader.",
          "en": "Streams log entries and periodic authority heartbeats."
        },
        "why": {
          "vi": "Thu thập phiếu xác nhận đa số chéo vùng khả dụng.",
          "en": "Collects cross-AZ quorum acknowledgments."
        }
      }
    },
    "leader-f2": {
      "style": "heartbeat",
      "inspector": {
        "what": {
          "vi": "Kênh RPC AppendEntries & Heartbeat giữa Node 1 và Node 3 (~3 ms).",
          "en": "AppendEntries & Heartbeat RPC link between Node 1 and Node 3 (~3 ms)."
        },
        "how": {
          "vi": "Truyền nhật ký song song với kênh sang Node 2.",
          "en": "Replicates log entries in parallel with Node 2."
        },
        "why": {
          "vi": "Giúp Leader vẫn đạt 2/3 ngay cả khi một trong hai Follower gặp sự cố.",
          "en": "Maintains 2/3 majority even if one Follower fails."
        }
      }
    },
    "leader-storage": {
      "inspector": {
        "what": {
          "vi": "Lệnh thực thi xuống Kho dữ liệu kèm theo Fencing Token.",
          "en": "State machine write to Storage carrying Fencing Token."
        },
        "how": {
          "vi": "Đính kèm số token tăng dần theo mỗi nhiệm kỳ Leader.",
          "en": "Attaches monotonically increasing epoch/term token."
        },
        "why": {
          "vi": "Ngăn tiến trình Leader cũ ghi đè trạng thái của nhiệm kỳ mới.",
          "en": "Prevents stale leaders from corrupting newer state."
        }
      }
    }
  },
