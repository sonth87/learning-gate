{
  "version": 1,
  "base": "s1-multi-db",
  "nodes": {
    "client": {
      "shape": "crowd",
      "tone": "blue",
      "label": {
        "vi": "Khách đặt chuyến",
        "en": "Travelers"
      },
      "inspector": {
        "what": {
          "vi": "Khách hàng đặt trọn gói chuyến du lịch (vé máy bay + phòng khách sạn + thanh toán) ở tốc độ 450 req/s.",
          "en": "Travelers booking bundled trips (flight + hotel + payment) at 450 req/s."
        },
        "how": {
          "vi": "Kỳ vọng cả chuyến đi được xác nhận đồng bộ, hoặc nếu hết phòng khách sạn thì không bị trừ tiền và không giữ vé lẻ.",
          "en": "Expects atomic business outcome: either the whole trip is booked or nothing is billed."
        },
        "why": {
          "vi": "Đặt ra bài toán toàn vẹn dữ liệu trải ngang qua nhiều cơ sở dữ liệu độc lập.",
          "en": "Requires cross-service data integrity without a shared relational database."
        }
      }
    },
    "coord": {
      "shape": "block",
      "tone": "purple",
      "icon": "git",
      "label": {
        "vi": "Trip Coordinator",
        "en": "Trip Coordinator"
      },
      "inspector": {
        "what": {
          "vi": "Bộ điều phối trung tâm: đóng vai Coordinator trong 2PC hoặc Saga Orchestrator lưu máy trạng thái bước đi.",
          "en": "Central coordinator acting as 2PC Coordinator or stateful Saga Orchestrator."
        },
        "how": {
          "vi": "Trong 2PC, hỏi phiếu Prepare rồi phát lệnh Commit. Trong Saga, gọi tuần tự từng dịch vụ và kích hoạt bù trừ ngược nếu có bước báo lỗi.",
          "en": "Runs Prepare/Commit in 2PC, or executes local steps and reverse compensations in Saga."
        },
        "why": {
          "vi": "Trong 2PC đơn lẻ, nếu node này dừng ngay sau Prepare ở giây 20, các kho dữ liệu bên dưới bị kẹt khoá in-doubt cho tới khi nó sống lại.",
          "en": "In 2PC, crashing after Prepare leaves downstream databases locked in-doubt until coordinator recovery."
        }
      }
    },
    "flight_db": {
      "shape": "db",
      "tone": "green",
      "label": {
        "vi": "Flight DB",
        "en": "Flight DB"
      },
      "inspector": {
        "what": {
          "vi": "Cơ sở dữ liệu riêng của dịch vụ Hàng không quản lý ghế chuyến bay.",
          "en": "Dedicated database owned by the Flight microservice."
        },
        "how": {
          "vi": "Chỉ hỗ trợ giao dịch ACID cục bộ bên trong chính nó; không chia sẻ WAL hay bảng khoá với Hotel DB.",
          "en": "Supports local ACID transactions only; shares no WAL or lock table with Hotel DB."
        },
        "why": {
          "vi": "Trong Saga, bước T1 đặt vé bay sẽ COMMIT cục bộ ngay với trạng thái PENDING và có hàm bù trừ C1 để huỷ vé.",
          "en": "In Saga, T1 commits locally in PENDING state and exposes compensating action C1 to cancel."
        }
      }
    },
    "hotel_db": {
      "shape": "db",
      "tone": "orange",
      "label": {
        "vi": "Hotel DB",
        "en": "Hotel DB"
      },
      "inspector": {
        "what": {
          "vi": "Cơ sở dữ liệu riêng của dịch vụ Khách sạn quản lý tồn kho phòng nghỉ.",
          "en": "Dedicated database owned by the Hotel microservice."
        },
        "how": {
          "vi": "Kiểm tra số phòng trống theo ngày nhận trả; thường là nơi phát sinh lỗi nghiệp vụ hết phòng ở bước cuối.",
          "en": "Validates room availability by date; frequent source of late out-of-room rejections."
        },
        "why": {
          "vi": "Khi Hotel DB từ chối đơn, các bước đã COMMIT trước đó ở Flight DB và Payment DB buộc phải được bù trừ ngược.",
          "en": "When Hotel DB rejects a booking, prior committed steps in Flight and Payment must be compensated."
        }
      }
    },
    "pay_db": {
      "shape": "db",
      "tone": "yellow",
      "label": {
        "vi": "Payment DB",
        "en": "Payment DB"
      },
      "inspector": {
        "what": {
          "vi": "Sổ cái thanh toán quản lý giao dịch thu tiền và hoàn tiền kèm bảng khoá luỹ đẳng.",
          "en": "Payment ledger database tracking charges, refunds, and idempotency keys."
        },
        "how": {
          "vi": "Đối chiếu Idempotency-Key trước khi trừ tiền; khi bù trừ sẽ ghi thêm một bút toán REFUND mới thay vì xoá lịch sử cũ.",
          "en": "Deduplicates via Idempotency-Key and records an explicit REFUND ledger entry on compensation."
        },
        "why": {
          "vi": "Đảm bảo an toàn tài chính ngay cả khi mạng rớt gói ACK khiến bộ điều phối gửi lại lệnh thu tiền.",
          "en": "Prevents double charges when lost ACK packets trigger orchestrator retries."
        }
      }
    }
  },
  "links": {
    "client-coord": {
      "inspector": {
        "what": {
          "vi": "Yêu cầu đặt trọn gói chuyến đi từ khách hàng.",
          "en": "Bundled trip booking request from client."
        },
        "how": {
          "vi": "Đính kèm Idempotency-Key sinh từ phía thiết bị khách.",
          "en": "Carries a client-generated Idempotency-Key."
        },
        "why": {
          "vi": "Cho phép khách bấm thử lại an toàn khi mạng di động chập chờn.",
          "en": "Allows safe client retries over unreliable mobile networks."
        }
      }
    },
    "coord-flight": {
      "inspector": {
        "what": {
          "vi": "Chặng gọi RPC/HTTP từ bộ điều phối sang kho dữ liệu chuyến bay.",
          "en": "Coordinator hop to Flight domain store."
        },
        "how": {
          "vi": "Thực thi bước giữ ghế T1 hoặc bước giải phóng ghế C1.",
          "en": "Executes forward reservation T1 or compensating release C1."
        },
        "why": {
          "vi": "Tách biệt hoàn toàn qua mạng nên có thể quá hạn bất kỳ lúc nào.",
          "en": "Network hop subject to timeouts and packet loss."
        }
      }
    },
    "coord-hotel": {
      "inspector": {
        "what": {
          "vi": "Chặng gọi từ bộ điều phối sang kho dữ liệu khách sạn.",
          "en": "Coordinator hop to Hotel domain store."
        },
        "how": {
          "vi": "Thực thi bước đặt phòng hoặc huỷ phòng bù trừ.",
          "en": "Executes room booking or compensating cancellation."
        },
        "why": {
          "vi": "Không thể dùng chung câu lệnh ROLLBACK của cơ sở dữ liệu chuyến bay.",
          "en": "Cannot share a local SQL ROLLBACK with Flight DB."
        }
      }
    },
    "coord-pay": {
      "inspector": {
        "what": {
          "vi": "Chặng gọi thu tiền / hoàn tiền tới sổ cái thanh toán.",
          "en": "Charge and refund hop to Payment DB."
        },
        "how": {
          "vi": "Truyền mã khoá luỹ đẳng riêng cho từng bước (ví dụ trip_901:charge và trip_901:refund).",
          "en": "Passes step-specific idempotency keys for charge and refund."
        },
        "why": {
          "vi": "Ngăn rủi ro trừ tiền hai lần hoặc hoàn tiền hai lần.",
          "en": "Prevents both duplicate charges and duplicate refunds."
        }
      }
    }
  },
