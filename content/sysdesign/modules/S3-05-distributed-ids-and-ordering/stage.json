{
  "version": 1,
  "base": "s9-scale-live",
  "nodes": {
    "client": {
      "shape": "crowd",
      "tone": "blue",
      "label": {
        "vi": "Người dùng",
        "en": "Users"
      },
      "inspector": {
        "what": {
          "vi": "Khách hàng gửi lưu lượng thiên về ghi (75% đặt đơn mới, 25% tra cứu đơn).",
          "en": "Write-heavy e-commerce traffic (75% new orders, 25% order lookups)."
        },
        "how": {
          "vi": "Tăng từ 600 lên 3.600 req/s trong đợt cao điểm mở bán.",
          "en": "Ramps from 600 to 3,600 req/s during a flash sale."
        },
        "why": {
          "vi": "Tải ghi cao làm lộ rõ chi phí của việc xin ID qua mạng và phân mảnh B-tree.",
          "en": "Heavy write volume exposes ID coordination bottlenecks and B-tree write amplification."
        }
      }
    },
    "lb": {
      "shape": "block",
      "tone": "purple",
      "icon": "layers",
      "label": {
        "vi": "Load Balancer",
        "en": "Load Balancer"
      },
      "inspector": {
        "what": {
          "vi": "Cặp cân bằng tải dự phòng (2 instance) điều phối lưu lượng vào Order Service.",
          "en": "Redundant Load Balancer pair routing requests to Order Service."
        },
        "how": {
          "vi": "Chia đều Round-robin không giữ trạng thái.",
          "en": "Stateless Round-robin distribution."
        },
        "why": {
          "vi": "Chạy cặp dự phòng để tầng vào không trở thành SPOF.",
          "en": "Active-active pair eliminates entry-tier SPOF."
        }
      }
    },
    "app": {
      "shape": "block",
      "tone": "green",
      "icon": "cpu",
      "label": {
        "vi": "Order Service",
        "en": "Order Service"
      },
      "inspector": {
        "what": {
          "vi": "Cụm 3 máy chủ xử lý đơn hàng, mỗi máy mang một worker_id (0..1023) riêng.",
          "en": "Three stateless Order Service instances, each assigned a distinct worker_id."
        },
        "how": {
          "vi": "Khi tắt Ticket Server, mỗi máy tự sinh mã Snowflake 64-bit ngay trong RAM với tốc độ 4.096 ID/ms.",
          "en": "When Ticket Server is disabled, generates 64-bit Snowflake IDs in-memory at 4,096 IDs/ms."
        },
        "why": {
          "vi": "Loại bỏ hoàn toàn chặng gọi mạng xin ID và cho phép mở rộng ngang độc lập.",
          "en": "Eliminates network round-trips for ID allocation and scales out linearly."
        }
      }
    },
    "ticket": {
      "shape": "block",
      "tone": "rose",
      "icon": "hash",
      "label": {
        "vi": "Ticket Server",
        "en": "Ticket Server"
      },
      "inspector": {
        "what": {
          "vi": "Máy chủ bộ đếm tập trung cấp phát ID tuần tự qua mạng (μ = 1.200 ID/s).",
          "en": "Centralized counter server issuing sequential IDs over the network (μ = 1,200 IDs/s)."
        },
        "how": {
          "vi": "Mỗi lệnh tạo đơn phải gọi đồng bộ tới đây để tăng bộ đếm bền vững trước khi chèn DB.",
          "en": "Every order write makes a synchronous RPC here to increment a shared counter."
        },
        "why": {
          "vi": "Khi chỉ chạy 1 máy, đây vừa là điểm lỗi đơn (SPOF) vừa là cổ chai chặn trần ghi ở 1.200 đơn/giây.",
          "en": "As a single instance, acts as both a critical write SPOF and a 1,200 writes/s bottleneck."
        },
        "tip": {
          "vi": "Tắt thành phần này để chuyển sang sinh Snowflake/UUIDv7 cục bộ ngay tại Order Service.",
          "en": "Disable this component to switch to local in-memory Snowflake/UUIDv7 generation."
        }
      }
    },
    "db": {
      "shape": "db",
      "tone": "orange",
      "label": {
        "vi": "Order DB Shards",
        "en": "Order DB Shards"
      },
      "inspector": {
        "what": {
          "vi": "Cụm cơ sở dữ liệu đơn hàng đã phân mảnh (mỗi shard có cặp bản sao dự phòng).",
          "en": "Partitioned Order Database cluster with replicated shards."
        },
        "how": {
          "vi": "Dùng khoá chính BIGINT 64-bit có thứ tự thời gian để chèn thẳng vào trang lá bên phải của B-tree.",
          "en": "Uses time-ordered 64-bit BIGINT primary keys for sequential rightmost B-tree appends."
        },
        "why": {
          "vi": "Tránh tách trang ngẫu nhiên của UUID v4 và tăng thông lượng ghi tuyến tính theo số shard.",
          "en": "Avoids random UUIDv4 page splits and scales write throughput with shard count."
        }
      }
    }
  },
  "links": {
    "client-lb": {
      "inspector": {
        "what": {
          "vi": "Kết nối từ người dùng vào hệ thống đặt hàng.",
          "en": "Public client traffic."
        },
        "how": {
          "vi": "Mang 75% lệnh tạo đơn mới và 25% lệnh xem đơn.",
          "en": "Carries 75% order writes and 25% reads."
        },
        "why": {
          "vi": "Đo thông lượng tạo đơn và độ trễ đầu-cuối.",
          "en": "Measures end-to-end order ingestion SLOs."
        }
      }
    },
    "lb-app": {
      "inspector": {
        "what": {
          "vi": "Đường chia tải sang 3 instance Order Service.",
          "en": "Load-balanced link to Order Service."
        },
        "how": {
          "vi": "Phân phối đều yêu cầu giữa các máy ứng dụng.",
          "en": "Splits requests evenly across instances."
        },
        "why": {
          "vi": "Giữ mức bận CPU ứng dụng cân bằng.",
          "en": "Balances application CPU load."
        }
      }
    },
    "app-ticket": {
      "inspector": {
        "what": {
          "vi": "Chặng gọi mạng đồng bộ xin cấp ID cho mỗi đơn hàng mới.",
          "en": "Synchronous RPC to fetch a unique ID per write."
        },
        "how": {
          "vi": "Chỉ đi qua ở 75% lưu lượng là thao tác ghi; biến mất khi chuyển sang sinh Snowflake cục bộ.",
          "en": "Triggered on all writes; bypassed completely once local Snowflake is enabled."
        },
        "why": {
          "vi": "Minh hoạ chi phí phối hợp tập trung trên đường nóng.",
          "en": "Illustrates centralized coordination overhead on the hot write path."
        }
      }
    },
    "app-db": {
      "inspector": {
        "what": {
          "vi": "Đường ghi đơn hàng và đọc tra cứu xuống cụm Order DB Shards.",
          "en": "Read/write connection to partitioned Order DB Shards."
        },
        "how": {
          "vi": "Định tuyến tới đúng shard theo khoá phân mảnh.",
          "en": "Routes operations across database shards."
        },
        "why": {
          "vi": "Lưu trữ bền vững toàn bộ đơn hàng.",
          "en": "Persists order records durably."
        }
      }
    }
  },
