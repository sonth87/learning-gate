{
  "version": 1,
  "base": "s1-overview",
  "nodes": {
    "client": {
      "shape": "crowd",
      "tone": "blue",
      "label": {
        "vi": "Người dùng gõ tìm kiếm",
        "en": "Search Clients"
      },
      "inspector": {
        "what": {
          "vi": "Người dùng gõ từng ký tự vào ô tìm kiếm, tạo ra tới 50.000 QPS vào giờ cao điểm.",
          "en": "Users typing search queries, generating up to 50,000 QPS at peak."
        },
        "how": {
          "vi": "Áp dụng Debouncing (chờ 150–200 ms sau lần gõ cuối) và Cache trình duyệt để cắt 40–60% request thừa.",
          "en": "Uses 150–200 ms debouncing and local browser caching to trim redundant requests."
        },
        "why": {
          "vi": "Ngưỡng cảm nhận tức thì là dưới 100 ms; vượt ngưỡng này trải nghiệm gõ sẽ bị khựng.",
          "en": "Human perception threshold for instant feedback is under 100 ms."
        }
      }
    },
    "prefix_cache": {
      "shape": "block",
      "tone": "yellow",
      "icon": "zap",
      "label": {
        "vi": "Prefix Cache (1–3 ký tự)",
        "en": "Prefix Cache (1–3 chars)"
      },
      "inspector": {
        "what": {
          "vi": "Bộ nhớ đệm RAM lưu sẵn danh sách Top-K gợi ý cho các tiền tố ngắn 1–3 ký tự (a, ab, sys...).",
          "en": "In-memory cache holding Top-K suggestions for short 1–3 character prefixes."
        },
        "how": {
          "vi": "Số lượng tiền tố 1–3 ký tự rất hữu hạn (~18.278 tổ hợp chữ cái), nhưng lại chiếm tới ~90% tổng lượt truy vấn.",
          "en": "1–3 char prefixes are bounded (~18,278 letter combinations) yet absorb ~90% of queries."
        },
        "why": {
          "vi": "Trả lời trong ~1 ms và bảo vệ cụm Trie Shards khỏi 50.000 QPS.",
          "en": "Serves hits in ~1 ms and shields Trie Shards from 50,000 QPS."
        }
      }
    },
    "trie_shards": {
      "shape": "block",
      "tone": "purple",
      "icon": "cpu",
      "label": {
        "vi": "Trie Shards (RAM)",
        "en": "Trie Shards (In-Memory)"
      },
      "inspector": {
        "what": {
          "vi": "Cụm máy chủ giữ cây Trie trong RAM, được phân mảnh (shard) theo dải ký tự đầu tiên (a–g, h–p, q–z).",
          "en": "In-memory Trie servers partitioned by leading prefix range (a–g, h–p, q–z)."
        },
        "how": {
          "vi": "Mỗi nút trên cây Trie lưu sẵn Top-K từ khoá phổ biến nhất của nhánh đó để tra cứu trong O(p) với p là độ dài tiền tố.",
          "en": "Each Trie node pre-caches Top-K results so lookups run in O(p) time."
        },
        "why": {
          "vi": "Xử lý các tiền tố dài (4+ ký tự) bị Cache Miss với độ trễ chỉ vài mili-giây.",
          "en": "Handles longer prefix cache misses (4+ chars) in single-digit milliseconds."
        }
      }
    },
    "log_aggregator": {
      "shape": "block",
      "tone": "yellow",
      "icon": "filter",
      "label": {
        "vi": "Query Log Aggregator",
        "en": "Query Log Aggregator"
      },
      "inspector": {
        "what": {
          "vi": "Đường ống phụ trợ thu thập nhật ký tìm kiếm và tổng hợp tần suất từ khóa theo cửa sổ thời gian.",
          "en": "Offline pipeline aggregating raw search logs into weighted prefix frequencies."
        },
        "how": {
          "vi": "Gom lô (MapReduce / Spark) và áp dụng hệ số suy giảm theo thời gian để ưu tiên xu hướng mới.",
          "en": "Batches query counts with time-decay weighting to surface trending searches."
        },
        "why": {
          "vi": "Tách hoàn toàn tải ghi thống kê ra khỏi đường đọc thời gian thực 50.000 QPS.",
          "en": "Completely isolates heavy analytics writes from the 50,000 QPS real-time read path."
        }
      }
    },
    "trie_builder": {
      "shape": "block",
      "tone": "green",
      "icon": "cpu",
      "label": {
        "vi": "Offline Trie Builder",
        "en": "Offline Trie Builder"
      },
      "inspector": {
        "what": {
          "vi": "Bộ dựng lại cây Trie và tính sẵn Top-5 tại mỗi nút ở hậu trường.",
          "en": "Background worker building new Trie snapshots with precomputed Top-5 per node."
        },
        "how": {
          "vi": "Dựng bản chụp (snapshot) hoàn chỉnh rồi đẩy sang các Trie Shards bằng kỹ thuật tráo đổi con trỏ nguyên tử (Atomic Swap).",
          "en": "Builds immutable Trie images and ships them to Trie Shards for lock-free atomic swap."
        },
        "why": {
          "vi": "Đảm bảo các Trie Shards phục vụ đọc 100% không bao giờ bị khóa bởi thao tác cập nhật cây.",
          "en": "Ensures read-serving Trie Shards never suffer write locks during updates."
        }
      }
    }
  },
  "links": {
    "client-prefix_cache": {
      "inspector": {
        "what": {
          "vi": "Yêu cầu gợi ý gửi từ ô tìm kiếm tới cụm Prefix Cache.",
          "en": "Typeahead lookup requests from search clients to Prefix Cache."
        }
      }
    },
    "prefix_cache-trie_shards": {
      "inspector": {
        "what": {
          "vi": "Chuyển tiếp các tiền tố dài hoặc chưa có trong Cache xuống cụm Trie Shards.",
          "en": "Forwards cache misses (long/rare prefixes) to in-memory Trie Shards."
        }
      }
    },
