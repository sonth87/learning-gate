{
  "version": 1,
  "base": "s1-path",
  "nodes": {
    "client": {
      "shape": "crowd",
      "tone": "blue",
      "label": {
        "vi": "Người dùng",
        "en": "Users"
      },
      "inspector": {
        "what": {
          "vi": "Nhóm người dùng gửi request tới hệ thống qua Internet.",
          "en": "Concurrent users sending requests to the system over the Internet."
        },
        "how": {
          "vi": "Mỗi người dùng gửi request độc lập; tổng số request mỗi giây (λ) là tải đầu vào của cả hệ thống. Trong mô phỏng, λ tăng từ 200 lên 5.000 req/s.",
          "en": "Users send independent requests; aggregate arrival rate (λ) drives system load from 200 to 5,000 req/s."
        },
        "why": {
          "vi": "Tải đầu vào là đại lượng đến từ bên ngoài; kiến trúc phía sau phải chịu được mức λ mục tiêu.",
          "en": "Arrival traffic is external; backend capacity must sustain target λ."
        },
        "tip": {
          "vi": "Luôn ghi kèm mức tải λ khi đo: cùng một thành phần có thể êm ở 1.000 req/s nhưng nghẽn ở 3.000 req/s.",
          "en": "Always record λ alongside latency: a component healthy at 1,000 req/s can saturate at 3,000 req/s."
        }
      }
    },
    "lb": {
      "shape": "block",
      "tone": "purple",
      "icon": "layers",
      "label": {
        "vi": "Load Balancer",
        "en": "Load Balancer"
      },
      "inspector": {
        "what": {
          "vi": "Load Balancer nhận request đầu vào và phân phối đều sang các instance App (μ = 20.000 req/s).",
          "en": "Distributes incoming traffic evenly across App instances (μ = 20,000 req/s)."
        },
        "how": {
          "vi": "Dùng thuật toán Round-robin và loại instance lỗi khi Health Check thất bại, chỉ cộng thêm vài phần mười mili-giây.",
          "en": "Uses Round-robin routing with health checks, adding sub-millisecond overhead."
        },
        "why": {
          "vi": "Giúp tầng App mở rộng ngang thêm nhiều máy mà người dùng chỉ cần gọi một điểm vào duy nhất.",
          "en": "Lets the stateless App tier scale out horizontally behind a single endpoint."
        },
        "tip": {
          "vi": "Load Balancer hiếm khi nghẽn về thông lượng, nhưng cần cặp dự phòng để tránh điểm lỗi đơn (SPOF).",
          "en": "Rarely a throughput bottleneck, but deploy active-passive pairs to avoid a single point of failure."
        }
      }
    },
    "app1": {
      "shape": "block",
      "tone": "green",
      "icon": "cpu",
      "label": {
        "vi": "App 1",
        "en": "App 1"
      },
      "inspector": {
        "what": {
          "vi": "Instance ứng dụng xử lý logic nghiệp vụ (μ = 1.800 req/s mỗi máy).",
          "en": "Stateless application server executing business logic (μ = 1,800 req/s)."
        },
        "how": {
          "vi": "Mỗi instance xử lý trung bình khoảng 12 ms rồi đọc Cache; khi chạy 3 máy song song tổng năng lực đạt 5.400 req/s.",
          "en": "Processes each request in ~12 ms before querying Cache; 3 instances provide 5,400 req/s aggregate capacity."
        },
        "why": {
          "vi": "Tầng App không giữ trạng thái nên dễ nhân bản ngang khi CPU ứng dụng là điểm nghẽn.",
          "en": "Stateless design allows horizontal scaling whenever App CPU becomes the bottleneck."
        },
        "tip": {
          "vi": "Khi ρ của App còn thấp (0,56) mà hệ thống vẫn chậm, thêm App không giải quyết được nghẽn ở tầng dưới.",
          "en": "When App utilization is low (0.56), adding App instances will not relieve a downstream DB bottleneck."
        }
      }
    },
    "app2": {
      "shape": "block",
      "tone": "green",
      "icon": "cpu",
      "label": {
        "vi": "App 2",
        "en": "App 2"
      },
      "inspector": {
        "what": {
          "vi": "Instance ứng dụng thứ hai, cấu hình giống hệt App 1 (μ = 1.800 req/s).",
          "en": "Second stateless App instance identical to App 1 (μ = 1,800 req/s)."
        },
        "how": {
          "vi": "Nhận 1/3 lưu lượng từ Load Balancer và xử lý độc lập.",
          "en": "Receives one-third of traffic from the Load Balancer."
        },
        "why": {
          "vi": "Đảm bảo chia sẻ tải đồng đều và duy trì phục vụ nếu một máy gặp sự cố.",
          "en": "Shares compute load and provides redundancy if another instance fails."
        },
        "tip": {
          "vi": "So sánh ρ giữa các instance: nếu một máy cao bất thường, hãy kiểm tra khoá phân vùng hoặc thuật toán chia tải.",
          "en": "Compare ρ across instances to spot uneven load balancing early."
        }
      }
    },
    "app3": {
      "shape": "block",
      "tone": "green",
      "icon": "cpu",
      "label": {
        "vi": "App 3",
        "en": "App 3"
      },
      "inspector": {
        "what": {
          "vi": "Instance ứng dụng thứ ba trong cụm 3 máy (tổng μ = 5.400 req/s).",
          "en": "Third stateless App instance (5,400 req/s combined tier capacity)."
        },
        "how": {
          "vi": "Nhận 1/3 lưu lượng từ Load Balancer và gọi sang Cache.",
          "en": "Processes one-third of requests and forwards lookups to Cache."
        },
        "why": {
          "vi": "Giữ mức sử dụng mỗi máy ở 56% khi tải đạt 3.000 req/s.",
          "en": "Keeps per-instance utilization around 56% at 3,000 req/s."
        },
        "tip": {
          "vi": "Chỉ mở rộng thêm instance khi chính tầng này đang có ρ cao nhất trên đường đi.",
          "en": "Only scale out a tier when it has the highest utilization ρ on the request path."
        }
      }
    },
    "cache": {
      "shape": "block",
      "tone": "yellow",
      "icon": "zap",
      "label": {
        "vi": "Cache",
        "en": "Cache"
      },
      "inspector": {
        "what": {
          "vi": "Bộ nhớ đệm Read-through lưu kết quả đọc nóng trong RAM (μ = 40.000 req/s).",
          "en": "In-memory Read-through Cache absorbing repeated reads (μ = 40,000 req/s)."
        },
        "how": {
          "vi": "Nếu Hit thì trả kết quả trong ~0,5 ms; nếu Miss thì truy vấn Database rồi lưu lại. Với 25.000 / 50.000 key, Hit Ratio đạt khoảng 52%.",
          "en": "Returns hits in ~0.5 ms; on misses, fetches from Database and populates RAM (~52% hit ratio at 25k keys)."
        },
        "why": {
          "vi": "Mỗi lượt Cache Hit giúp chặn một truy vấn khỏi rơi xuống Database đang bận.",
          "en": "Every cache hit shields the stateful Database from an expensive disk/index lookup."
        },
        "tip": {
          "vi": "Tăng dung lượng key để nâng Hit Ratio là cách giảm tải vào Database rẻ hơn nhiều so với nâng cấp cụm DB.",
          "en": "Increasing cache hit ratio is often the most cost-effective way to reduce Database load."
        }
      }
    },
    "db": {
      "shape": "db",
      "tone": "orange",
      "label": {
        "vi": "Database",
        "en": "Database"
      },
      "inspector": {
        "what": {
          "vi": "Cơ sở dữ liệu lưu trữ bền vững, xử lý tối đa μ = 1.600 req/s.",
          "en": "Primary stateful Database with maximum service rate μ = 1,600 req/s."
        },
        "how": {
          "vi": "Mất khoảng 4 ms mỗi truy vấn khi rảnh. Khi ρ tiến sát 1,00, các truy vấn dồn vào hàng đợi làm độ trễ tăng dựng đứng và đánh rớt khi tràn.",
          "en": "Serves queries in ~4 ms when idle, but queues build rapidly as ρ approaches 1.00."
        },
        "why": {
          "vi": "Vì giữ trạng thái bền vững nên khó mở rộng ngang; với 53% request đi xuống DB, trần tải toàn hệ thống là 1.600 / 0,531 ≈ 3.010 req/s.",
          "en": "Stateful storage is hardest to scale horizontally, capping system sustainable load at ~3,010 req/s."
        },
        "tip": {
          "vi": "Ưu tiên thêm chỉ mục (Index), tối ưu câu truy vấn và nâng Cache Hit Ratio trước khi tăng cỡ máy Database.",
          "en": "Add missing indexes, tune slow queries, and raise Cache Hit Ratio before scaling up DB hardware."
        }
      }
    }
  },
  "links": {
    "client-lb": {
      "inspector": {
        "what": {
          "vi": "Đường truyền từ người dùng qua Internet tới hệ thống.",
          "en": "Public Internet hop from end users to the entry tier."
        },
        "how": {
          "vi": "Độ trễ phụ thuộc khoảng cách địa lý và bắt tay TLS/TCP.",
          "en": "Latency depends on geographic distance and TCP/TLS handshakes."
        },
        "why": {
          "vi": "Đặt ngưỡng sàn cho tổng thời gian phản hồi khứ hồi (RTT).",
          "en": "Sets the network floor for end-to-end round-trip latency."
        },
        "tip": {
          "vi": "Nếu chặng mạng ngoài chiếm tỷ trọng lớn, dùng CDN hoặc đặt cụm máy chủ gần vùng người dùng.",
          "en": "Use CDN edge caching or regional deployment when WAN RTT dominates."
        }
      }
    },
    "lb-app1": {
      "inspector": {
        "what": {
          "vi": "Kết nối nội bộ từ Load Balancer sang App 1.",
          "en": "Internal hop from Load Balancer to App 1."
        },
        "how": {
          "vi": "Chuyển tiếp lưu lượng theo vòng Round-robin trong mạng nội bộ tốc độ cao.",
          "en": "Forwards requests via Round-robin within the same private network."
        },
        "why": {
          "vi": "Giữ mức sử dụng CPU đồng đều giữa các instance ứng dụng.",
          "en": "Keeps request load balanced across application instances."
        }
      }
    },
    "lb-app2": {
      "inspector": {
        "what": {
          "vi": "Kết nối nội bộ từ Load Balancer sang App 2.",
          "en": "Internal hop from Load Balancer to App 2."
        },
        "how": {
          "vi": "Chuyển tiếp 1/3 lưu lượng vào App 2.",
          "en": "Forwards one-third of requests to App 2."
        },
        "why": {
          "vi": "Phân tán tải ngang không cần thay đổi phía client.",
          "en": "Transparently distributes horizontal load."
        }
      }
    },
    "lb-app3": {
      "inspector": {
        "what": {
          "vi": "Kết nối nội bộ từ Load Balancer sang App 3.",
          "en": "Internal hop from Load Balancer to App 3."
        },
        "how": {
          "vi": "Chuyển tiếp 1/3 lưu lượng vào App 3.",
          "en": "Forwards one-third of requests to App 3."
        },
        "why": {
          "vi": "Đảm bảo cả 3 máy App chia tải ngang nhau.",
          "en": "Balances traffic evenly across all three App servers."
        }
      }
    },
    "app1-cache": {
      "inspector": {
        "what": {
          "vi": "Đường đọc/ghi tốc độ cao từ App 1 tới Cache.",
          "en": "Low-latency lookup hop from App 1 to Cache."
        },
        "how": {
          "vi": "Kiểm tra dữ liệu trong bộ nhớ RAM trước khi chạm xuống Database.",
          "en": "Checks in-memory key-value store before querying Database."
        },
        "why": {
          "vi": "Giúp hơn một nửa lượt đọc trả về ngay tại tầng Cache.",
          "en": "Short-circuits ~52% of read requests without touching disk."
        }
      }
    },
    "app2-cache": {
      "inspector": {
        "what": {
          "vi": "Đường đọc/ghi tốc độ cao từ App 2 tới Cache.",
          "en": "Low-latency lookup hop from App 2 to Cache."
        },
        "how": {
          "vi": "Chia sẻ chung không gian khoá bộ nhớ đệm với App 1 và App 3.",
          "en": "Shares the centralized read-through cache keyspace."
        },
        "why": {
          "vi": "Dữ liệu một máy vừa nạp vào Cache có lợi ngay cho các máy còn lại.",
          "en": "Keys warmed by one App instance immediately benefit all instances."
        }
      }
    },
    "app3-cache": {
      "inspector": {
        "what": {
          "vi": "Đường đọc/ghi tốc độ cao từ App 3 tới Cache.",
          "en": "Low-latency lookup hop from App 3 to Cache."
        },
        "how": {
          "vi": "Đặt Timeout ngắn (100 ms) để không khoá luồng ứng dụng.",
          "en": "Uses short 100 ms timeouts to prevent worker starvation."
        },
        "why": {
          "vi": "Giảm áp lực truy vấn xuống tầng lưu trữ phía sau.",
          "en": "Shields the backing Database from repetitive reads."
        }
      }
    },
    "cache-db": {
      "inspector": {
        "what": {
          "vi": "Đường truy vấn xuống Database khi Cache Miss hoặc thực hiện lệnh ghi.",
          "en": "Downstream query path to Database on Cache Misses and Writes."
        },
        "how": {
          "vi": "Khoảng 53% tổng request đi qua chặng này; cấu hình thử lại 2 lần không Backoff khiến tải dồn gấp bội khi DB chạm ngưỡng.",
          "en": "Carries ~53% of total traffic; immediate retries without backoff amplify overload when ρ ≥ 1."
        },
        "why": {
          "vi": "Là cổ chai quyết định thông lượng tối đa của toàn hệ thống.",
          "en": "Critical bottleneck path governing maximum system throughput."
        },
        "tip": {
          "vi": "Luôn kết hợp Exponential Backoff + Jitter và giới hạn ngân sách thử lại trên chặng vào Database.",
          "en": "Always pair retries with Exponential Backoff + Jitter and a retry budget."
        }
      }
    }
  },
