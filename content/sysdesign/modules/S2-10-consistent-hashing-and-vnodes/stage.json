    "client": {
      "shape": "crowd",
      "tone": "blue",
      "label": {
        "vi": "Người dùng",
        "en": "Users"
      },
      "inspector": {
        "what": {
          "vi": "Người dùng gửi ổn định 5.000 req/s (95% đọc, 5% ghi).",
          "en": "Users sending a steady 5,000 req/s (95% reads, 5% writes)."
        },
        "how": {
          "vi": "Dựa vào cụm Cache phân tán giữ Hit Ratio ~92% để bảo vệ Origin Database phía sau.",
          "en": "Relies on a distributed cache cluster (~92% hit ratio) to shield Origin Database."
        },
        "why": {
          "vi": "Nếu cụm Cache mất đồng loạt ánh xạ khoá lúc thêm máy, toàn bộ 5.000 req/s sẽ tràn thẳng xuống DB.",
          "en": "Mass cache remapping during scale-out dumps nearly all 5,000 req/s onto Origin DB."
        }
      }
    },
    "lb": {
      "shape": "block",
      "tone": "purple",
      "icon": "layers",
      "label": {
        "vi": "Load Balancer",
        "en": "Load Balancer"
      },
      "inspector": {
        "what": {
          "vi": "Bộ cân bằng tải chia đều request vào cụm App Hash Client.",
          "en": "Balances incoming requests across App instances."
        },
        "how": {
          "vi": "Định tuyến Round-robin tới 4 máy ứng dụng.",
          "en": "Round-robin across 4 stateless App servers."
        },
        "why": {
          "vi": "Giữ tầng ứng dụng luôn thông thoáng.",
          "en": "Keeps stateless compute evenly loaded."
        }
      }
    },
    "app": {
      "shape": "block",
      "tone": "green",
      "icon": "hash",
      "label": {
        "vi": "App Hash Client",
        "en": "App Hash Client"
      },
      "inspector": {
        "what": {
          "vi": "Thư viện định tuyến trong tầng App quyết định mỗi khoá thuộc về máy Cache nào.",
          "en": "Client-side hash router mapping each cache key to its owning Cache node."
        },
        "how": {
          "vi": "Hoặc tính hash(key) mod N (cũ), hoặc tìm nhị phân trên mảng điểm đã sắp xếp của Vòng băm nhất quán.",
          "en": "Uses either hash(key) mod N or binary search on a sorted Consistent Hash Ring."
        },
        "why": {
          "vi": "Thuật toán ánh xạ ở đây quyết định bao nhiêu phần trăm khoá bị Cache Miss khi thêm hoặc bớt máy.",
          "en": "The hashing algorithm here dictates what fraction of keys miss upon cluster resize."
        }
      }
    },
    "cache_1": {
      "shape": "block",
      "tone": "yellow",
      "icon": "zap",
      "label": {
        "vi": "Cache 1",
        "en": "Cache 1"
      },
      "inspector": {
        "what": {
          "vi": "Nút bộ nhớ đệm thứ nhất trong cụm phân tán (25.000 ops/s).",
          "en": "First distributed cache node (25,000 ops/s)."
        },
        "how": {
          "vi": "Với Consistent Hashing, giữ nguyên các khoá cũ ấm trong RAM khi thêm Cache 4.",
          "en": "Retains warm keys untouched when Cache 4 joins the ring."
        },
        "why": {
          "vi": "Ngăn các lượt đọc đang trúng Cache bỗng nhiên trở thành Cache Miss.",
          "en": "Prevents warm hits from turning into cold misses."
        }
      }
    },
    "cache_2": {
      "shape": "block",
      "tone": "yellow",
      "icon": "zap",
      "label": {
        "vi": "Cache 2",
        "en": "Cache 2"
      },
      "inspector": {
        "what": {
          "vi": "Nút bộ nhớ đệm thứ hai trong cụm phân tán.",
          "en": "Second distributed cache node."
        },
        "how": {
          "vi": "Với mod N, bị đổi chỉ số dư nên mất hiệu lực phần lớn khoá đang lưu.",
          "en": "Under mod N, remainder shifts invalidate most of its cached keys."
        },
        "why": {
          "vi": "Minh hoạ sự khác biệt giữa đổi chỗ 75% và đổi chỗ 25%.",
          "en": "Contrasts 75% remapping against 25% ring movement."
        }
      }
    },
    "cache_3": {
      "shape": "block",
      "tone": "yellow",
      "icon": "zap",
      "label": {
        "vi": "Cache 3",
        "en": "Cache 3"
      },
      "inspector": {
        "what": {
          "vi": "Nút bộ nhớ đệm thứ ba trong cụm phân tán.",
          "en": "Third distributed cache node."
        },
        "how": {
          "vi": "Nhận 1/4 lưu lượng sau khi cụm mở rộng từ 3 lên 4 nút.",
          "en": "Serves 1/4 of traffic after resizing from 3 to 4 nodes."
        },
        "why": {
          "vi": "Chia sẻ dung lượng RAM cho tập làm việc lớn.",
          "en": "Shares total working-set RAM capacity."
        }
      }
    },
    "cache_4": {
      "shape": "block",
      "tone": "blue",
      "icon": "sparkles",
      "label": {
        "vi": "Cache 4 (mới)",
        "en": "Cache 4 (new)"
      },
      "inspector": {
        "what": {
          "vi": "Nút bộ nhớ đệm thứ tư vừa được thêm vào cụm lúc t = 20 s.",
          "en": "Fourth cache node added to the cluster at t = 20 s."
        },
        "how": {
          "vi": "Trên vòng băm nhất quán, chỉ nhận bàn giao 1/(3+1) = 25% không gian khoá và làm ấm dần trong ~24 s.",
          "en": "On a Consistent Hash Ring, claims only 1/(3+1) = 25% of keys and warms up smoothly."
        },
        "why": {
          "vi": "Giúp mở rộng dung lượng RAM cụm Cache ngay trong giờ cao điểm mà không đánh sập DB.",
          "en": "Enables live cache scale-out under peak traffic without overloading Origin DB."
        }
      }
    },
    "db": {
      "shape": "db",
      "tone": "orange",
      "label": {
        "vi": "Origin Database",
        "en": "Origin Database"
      },
      "inspector": {
        "what": {
          "vi": "Cơ sở dữ liệu gốc phía sau cụm Cache, năng lực tối đa 2.000 ops/s.",
          "en": "Backing Origin Database with maximum service rate μ = 2,000 ops/s."
        },
        "how": {
          "vi": "Bình thường chỉ nhận ~630 ops/s (ρ = 0,32). Khi mod N làm 75% Cache nguội cùng lúc, DB vọt lên ~3.908 ops/s (ρ = 1,95).",
          "en": "Normally handles ~630 ops/s (ρ = 0.32), but spikes to ~3,908 ops/s under a 75% mod-N miss storm."
        },
        "why": {
          "vi": "Là nạn nhân thực sự của thuật toán băm tồi ở tầng Cache.",
          "en": "Suffers cascading overload whenever cache routing invalidates keys en masse."
        }
      }
    }
  },
