  {
    "id": "kube-ex-k00-3",
    "code": "K00.3",
    "title": "Tìm container đã dừng bị ẩn khỏi docker ps",
    "difficulty": 1,
    "tags": [
      "docker-ps",
      "exited",
      "inspection"
    ],
    "kind": "cli",
    "language": "shell",
    "filename": "terminal.sh",
    "prompt": "Đồng nghiệp báo rằng vừa chạy xong một tác vụ di trú DB mang tên `old-migration`, nhưng khi gõ `docker ps` thì chỉ thấy mỗi `api` đang chạy. Hãy sửa câu lệnh bên dưới để liệt kê **tất cả** container (bao gồm cả các container đã dừng `exited`) nhằm làm hiện diện `old-migration` trên màn hình.",
    "starter": "docker ps\n",
    "solution": "docker ps -a\n",
    "hints": [
      "`docker ps` mặc định ẩn các container ở trạng thái `exited`.",
      "Thêm cờ `-a` (hoặc `--all`): `docker ps -a`"
    ],
    "ref": "docker/node-api/Dockerfile.bad-root",
    "webGrade": true,
    "spec": {
      "kind": "cli",
      "initialState": {
        "docker": {
          "images": [
            {
              "repo": "node",
              "tag": "22-alpine",
              "sizeMB": 138
            }
          ],
          "containers": [
            {
              "id": "a10293847561",
              "name": "api",
              "image": "node:22-alpine",
              "status": "running",
              "exitCode": 0,
              "ports": [
                {
                  "host": 3000,
                  "container": 3000
                }
              ],
              "env": {},
              "volumes": [],
              "network": "bridge",
              "logs": [
                "API listening on 3000"
              ]
            },
            {
              "id": "f98172635400",
              "name": "old-migration",
              "image": "node:22-alpine",
              "status": "exited",
              "exitCode": 0,
              "ports": [],
              "env": {},
              "volumes": [],
              "network": "bridge",
              "logs": [
                "Applied 12 SQL migrations successfully."
              ]
            }
          ],
          "volumes": [],
          "networks": [
            "bridge",
            "host",
            "none"
          ]
        }
      },
      "rules": [
        {
          "id": "found-old-migration",
          "doc": "Kết quả đầu ra hiển thị container đã dừng `old-migration`",
          "target": "stdout-inspected",
          "contains": "old-migration"
        }
      ]
    }
  },
