# Firebase Auth (Google Sign-In) & Cloud Firestore configuration
# Copy this file to .env.local and fill in your Firebase Web App credentials.
# Also add these same variables in Vercel Project Settings -> Environment Variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
